{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
     "src/main/**/*",
     "src/preload/**/*",
     "src/constant/**/*"],
  // 排除自行添加的无关打包目录
  "exclude": ["download"],
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
